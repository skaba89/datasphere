# =============================================================================
# GuineaTender AI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="GuineaTender AI"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Base de données PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://guineatender:password@localhost:5432/guineatender_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change_this_refresh_secret_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d

# ── IA — Providers (configurer au moins un) ──────────────────────────────────
# Provider par défaut si non configuré par l'organisation
AI_DEFAULT_PROVIDER=anthropic

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter — accès à 200+ modèles (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# Groq — inférence ultra-rapide (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# GLM / Zhipu AI — GLM-4 (https://open.bigmodel.cn)
GLM_API_KEY=...

# Qwen / Alibaba DashScope (https://dashscope.aliyuncs.com)
QWEN_API_KEY=sk-...

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza...

# ── Mistral AI (option souveraine) ───────────────────────────────────────────
MISTRAL_API_KEY=...
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── Qdrant (base vecteurs) ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── MinIO (stockage fichiers) ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=guineatender

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@guineatender.ai
SMTP_PASS=your_smtp_password
SMTP_FROM="GuineaTender AI <noreply@guineatender.ai>"

# ── Orange Money (Guinée) ────────────────────────────────────────────────────
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/gn/v1
ORANGE_MONEY_CALLBACK_URL=${API_URL}/webhooks/orange-money

# ── MTN MoMo ─────────────────────────────────────────────────────────────────
MTN_MOMO_USER_ID=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# ── Firebase (notifications push mobile) ─────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── TELEMO API ────────────────────────────────────────────────────────────────
TELEMO_API_URL=https://telemo.gov.gn/api/v1
TELEMO_API_KEY=

# ── Scraping ──────────────────────────────────────────────────────────────────
SCRAPING_INTERVAL_MINUTES=120
SCRAPING_USER_AGENT="GuineaTenderBot/1.0 (+https://guineatender.ai/bot)"

# ── Sécurité ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://guineatender.ai
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug
